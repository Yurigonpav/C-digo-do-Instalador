{\f0\fs18 \b Este servidor deve ser usado EXCLUSIVAMENTE em:\b0\par}
\pard\sa120\li360\fi-180\tx360\sl240\slmult1
{\f0\fs18 \bullet\tab Redes locais de laborat\u243?rio controladas;\par}
{\f0\fs18 \bullet\tab Ambientes de sala de aula supervisionados;\par}
{\f0\fs18 \bullet\tab Testes com dispositivos pr\u243?prios ou autorizados.\par}
\pard\sa120\sl240\slmult1
